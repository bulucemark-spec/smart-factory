# ===== 数据库 =====
MYSQL_PASSWORD=smart123

# MySQL 数据目录（bind mount 到宿主机 E 盘，容器内固定为 /var/lib/mysql）
MYSQL_DATA_DIR=E:/docker/volumes/mysql-data

# ===== MinIO 对象存储 =====
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ===== JWT 密钥（生产环境务必修改为随机长字符串）=====
JWT_SECRET=smart-factory-default-secret-key-please-change-in-prod-0123456789abcdef

# ===== 前端访问端口（主机端口）=====
WEB_PORT=8088

# ===== 其余主机端口映射（如遇端口被占用可修改；容器内部端口保持不变）=====
GATEWAY_PORT=8090
MYSQL_PORT=3306
REDIS_PORT=6380
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# ===== 大模型（OpenAI 兼容接口）=====
# 不填 LLM_API_KEY 时，AI 服务自动降级为离线 Mock，不影响其他功能。
# 兼容 OpenAI 官方、各类 OpenAI 兼容网关及国内主流兼容服务：
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#   示例(国内兼容服务，按实际服务商文档填写):
#   LLM_BASE_URL=https://your-compatible-endpoint/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
